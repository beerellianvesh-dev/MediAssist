# --- LLM Provider ---
# One of: ollama, groq, openai, anthropic
LLM_PROVIDER=ollama

# --- Ollama (default, free, local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Groq (optional, free tier, cloud) ---
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# --- OpenAI (optional, paid) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (optional, paid) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Vector Store ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=medassist_drug_labels
# When running via docker-compose, point this at the chromadb service instead:
# CHROMA_HOST=chromadb
# CHROMA_PORT=8200

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Ingestion ---
OPENFDA_API_KEY=
OPENFDA_LIMIT=100

# --- RAG ---
RETRIEVAL_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend ---
API_BASE_URL=http://localhost:8000
